--- files/sbt.sh.in
+++ files/sbt.sh.in
@@ -1,2 +1,2 @@
 #!/bin/sh
-exec "%%LOCALBASE%%/bin/java" -Xms1024M -Xmx1024M -Xss4M -XX:ReservedCodeCacheSize=128m -Dsbt.io.jdktimestamps=true -jar "%%DATADIR%%/sbt-launch.jar" "$@"
+exec "%%JAVA_HOME%%/bin/java" -Xms1024M -Xmx1024M -Xss4M -XX:ReservedCodeCacheSize=128m -Dsbt.io.jdktimestamps=true -jar "%%DATADIR%%/sbt-launch.jar" "$@"
