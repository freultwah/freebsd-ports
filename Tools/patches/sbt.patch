--- Makefile
+++ Makefile
@@ -9,9 +9,13 @@
 
 LICENSE=	APACHE20
 
-RUN_DEPENDS=	infocmp:devel/ncurses
+RUN_DEPENDS=	infocmp:devel/ncurses \
+		openjdk25-headless>0:java/openjdk25@headless
 
-USES=		cpe java tar:tgz
+USES=		cpe tar:tgz
+
+JAVA_HOME=	${LOCALBASE}/openjdk25-headless
+SUB_LIST+=	JAVA_HOME=${JAVA_HOME}
 
 CPE_VENDOR=	scala.epfl
 
@@ -35,7 +39,8 @@
 .include <bsd.port.options.mk>
 
 post-patch:
-	@${REINPLACE_CMD} 's|%%PREFIX%%|${PREFIX}|' ${WRKSRC}/bin/sbt
+	@${REINPLACE_CMD} -e 's|%%PREFIX%%|${PREFIX}|' \
+		-e 's|%%JAVA_HOME%%|${JAVA_HOME}|' ${WRKSRC}/bin/sbt
 
 do-install:
 	${MKDIR} ${STAGEDIR}${DATADIR}
--- /dev/null
+++ files/patch-bin_sbt_java
@@ -0,0 +1,13 @@
+--- bin/sbt.orig
++++ bin/sbt
+@@ -12,7 +12,9 @@
+ declare -a print_sbt_script_version
+ declare -a shutdownall
+ declare -a original_args
+-declare java_cmd=java
++: "${JAVA_HOME:=%%JAVA_HOME%%}"
++export JAVA_HOME
++declare java_cmd="${JAVA_HOME}/bin/java"
+ declare java_version
+ declare init_sbt_version=2.0.9
