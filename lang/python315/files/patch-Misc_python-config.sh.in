--- Misc/python-config.sh.in.orig	2026-10-25 16:57:51 UTC
+++ Misc/python-config.sh.in
@@ -22,8 +22,7 @@ installed_prefix ()
 # Fails if the directory containing this script cannot be resolved.
 installed_prefix ()
 {
-    RESULT=$(cd "$(dirname "$1")" && pwd -P) || return 1
-    RESULT=$(dirname "$RESULT")
+    RESULT=$(dirname $(cd $(dirname $(realpath "$1")) && pwd -P)) || return 1
     if which readlink >/dev/null 2>&1 ; then
         if readlink -f "$RESULT" >/dev/null 2>&1; then
           RESULT=$(readlink -f "$RESULT")
