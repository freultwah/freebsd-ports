+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-SEL
+ */
+
+#![cfg(feature = "sqlite")]
+
+use nlp::language::Language;
+use store::{
+    backend::sqlite::SqliteStore,
+    search::{EmailSearchField, IndexDocument, SearchFilter, SearchQuery, TextMatch},
+    write::SearchIndex,
+};
+
+#[tokio::test]
+async fn estonian_index_and_search() {
+    let path = std::env::temp_dir().join(format!("stalwart-estonian-{}", rand::random::<u64>()));
+    std::fs::create_dir(&path).unwrap();
+    let store = SqliteStore::open(registry::schema::structs::SqliteStore {
+        path: path.to_str().unwrap().into(),
+        pool_workers: Some(1),
+        pool_max_connections: Some(1),
+    })
+    .unwrap();
+    store.create_tables().await.unwrap();
+
+    let mut documents = Vec::new();
+    for (id, text) in [(1, "Raamatutes"), (2, "Raamat"), (3, "Majades")] {
+        let mut document = IndexDocument::new(SearchIndex::Email).with_document_id(id);
+        document.index_text(EmailSearchField::Body, text, Language::Estonian);
+        documents.push(document);
+    }
+    store
+        .index_account_documents(0, SearchIndex::Email, documents, Vec::new())
+        .await
+        .unwrap();
+
+    for (value, op, expected) in [
+        ("raamatud", TextMatch::Standard, vec![1, 2]),
+        ("raamat", TextMatch::Standard, vec![1, 2]),
+        ("RAAMATUTES", TextMatch::Standard, vec![1, 2]),
+        ("majadega", TextMatch::Standard, vec![3]),
+        ("maja", TextMatch::Standard, vec![3]),
+        ("kassid", TextMatch::Standard, vec![]),
+        ("raamatud", TextMatch::Exact, vec![]),
+        ("raamatutes", TextMatch::Exact, vec![1]),
+    ] {
+        let query = SearchQuery::new(SearchIndex::Email)
+            .with_account_id(0)
+            .with_mask([1, 2, 3].into_iter().collect())
+            .with_filter(SearchFilter::Text {
+                field: EmailSearchField::Body.into(),
+                op,
+                value: value.into(),
+                language: Language::Estonian,
+            });
+        let results = store.query_account(query).await.unwrap();
+        assert_eq!(
+            results.iter().collect::<Vec<_>>(),
+            expected,
+            "{value} {op:?}"
+        );
+    }
+
+    drop(store);
+    std::fs::remove_dir_all(path).unwrap();
+}
