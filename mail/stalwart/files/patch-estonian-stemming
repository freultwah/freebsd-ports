+ *
+ * SPDX-License-Identifier: AGPL-3.0-only OR LicenseRef-SEL
+ */
+
+use nlp::language::{Language, stemmer::Stemmer};
+
+#[test]
+fn estonian_stems_and_token_offsets() {
+    let text = "RAAMATUD, raamatutes; majades õpilastega ja";
+    let tokens = Stemmer::new(text, Language::Estonian, 200).collect::<Vec<_>>();
+    for (token, (word, stem)) in tokens.iter().zip([
+        ("raamatud", Some("raama")),
+        ("raamatutes", Some("raama")),
+        ("majades", Some("maja")),
+        ("õpilastega", Some("õpilase")),
+        ("ja", None),
+    ]) {
+        assert_eq!(token.word, word);
+        assert_eq!(token.stemmed_word.as_deref(), stem);
+        assert_eq!(text[token.from..token.to].to_lowercase(), word);
+    }
+    assert_eq!(tokens.len(), 5);
+    assert_eq!(Stemmer::new(text, Language::Estonian, 2).count(), 1);
+}
+
+#[test]
+fn other_languages_keep_existing_stemming() {
+    for (code, word, stem) in [
+        ("en", "running", Some("run")),
+        ("de", "häusern", Some("haus")),
+        ("fi", "talossa", Some("talo")),
+        ("pl", "samochodami", None),
+        ("eo", "libroj", None),
+    ] {
+        let token = Stemmer::new(word, Language::from_iso_639(code).unwrap(), 200)
+            .next()
+            .unwrap();
+        assert_eq!(token.word, word);
+        assert_eq!(token.stemmed_word.as_deref(), stem, "{code}");
+    }
+}
